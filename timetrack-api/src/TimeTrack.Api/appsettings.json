{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "TimeTrack": "Data Source=timetrack.db"
  },
  "Database": {
    "Provider": "Sqlite",
    "SeedDemoData": false
  },
  "Jwt": {
    "Issuer": "TimeTrack.Api",
    "Audience": "TimeTrack.Web",
    "SigningKey": "",
    "ExpirationMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "RateLimiting": {
    "LoginPermitLimit": 5
  }
}
